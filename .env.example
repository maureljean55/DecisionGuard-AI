# Copy to .env and adjust. Never commit .env.
# All backend variables use the DG_ prefix (see apps/api/app/core/config.py).

# --- Runtime ---
DG_ENVIRONMENT=development          # development | test | staging | production
DG_LOG_LEVEL=INFO
DG_LOG_JSON=false                   # true in deployed environments

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in production (startup fails with the dev default).
DG_SECRET_KEY=

# --- Database (docker compose) ---
POSTGRES_USER=decisionguard
POSTGRES_PASSWORD=decisionguard
POSTGRES_DB=decisionguard
# Password of the unprivileged runtime role `dg_app` (subject to Row-Level Security).
# Read by infra/postgres/init on FIRST initialisation of the database volume only.
DG_APP_DB_PASSWORD=dg_app_dev
# Used when running the API outside Docker (inside Docker these are set by docker-compose.yml):
DG_DATABASE_URL=postgresql+psycopg://dg_app:dg_app_dev@localhost:5432/decisionguard
DG_MIGRATION_DATABASE_URL=postgresql+psycopg://decisionguard:decisionguard@localhost:5432/decisionguard
DG_REDIS_URL=redis://localhost:6379/0

# --- Web ---
DG_CORS_ORIGINS=["http://localhost:3000"]
DG_DEFAULT_LOCALE=fr
DG_PUBLIC_WEB_URL=http://localhost:3000   # used to build links in e-mails

# --- E-mail (development: Mailpit, web UI on http://localhost:8025) ---
DG_SMTP_HOST=localhost
DG_SMTP_PORT=1025
DG_SMTP_USERNAME=
DG_SMTP_PASSWORD=
DG_SMTP_USE_TLS=false
DG_EMAIL_FROM=DecisionGuard AI <no-reply@decisionguard.local>

# --- LLM provider ---
# "mock" = deterministic offline provider for development/tests. Forbidden in production.
DG_LLM_PROVIDER=mock                # mock | anthropic | openai
DG_LLM_API_KEY=
